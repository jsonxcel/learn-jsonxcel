			<item>
				<title>第一次轉換請求</title>
				<link>http://localhost:1313/zh-tw/learn/m01-why-jsonxcel/m01-l02-first-convert/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/zh-tw/learn/m01-why-jsonxcel/m01-l02-first-convert/</guid>
				<description>&lt;h2 id=&#34;學習目標&#34;&gt;學習目標&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;拼出合法的 &lt;code&gt;POST /api/convert&lt;/code&gt; 請求體&lt;/li&gt;&#xA;&lt;li&gt;用 BCP-47 目錄名選擇 &lt;code&gt;language&lt;/code&gt;（&lt;code&gt;en-US&lt;/code&gt;、&lt;code&gt;zh-CN&lt;/code&gt; 等）&lt;/li&gt;&#xA;&lt;li&gt;在 &lt;code&gt;output_format: &amp;quot;excel&amp;quot;&lt;/code&gt; 與 &lt;code&gt;&amp;quot;pdf&amp;quot;&lt;/code&gt; 之間切換&lt;/li&gt;&#xA;&lt;li&gt;理解 &lt;code&gt;return_file_stream&lt;/code&gt; 控制的流式下載與後設資料響應&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;aside&#xD;&#xA;  class=&#34;jx-lesson-demo my-8 rounded-xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/60&#34;&#xD;&#xA;  data-jx-demo&#xD;&#xA;  data-template-name=&#34;lesson_m01_first_convert&#34;&#xD;&#xA;  data-language=&#34;zh-TW&#34;&#xD;&#xA;  data-api-base=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;  data-site-root=&#34;http://localhost:1313&#34;&#xD;&#xA;  data-sample-url=&#34;http://localhost:1313/samples/zh-TW/lesson_m01_first_convert.json&#34;&#xD;&#xA;  data-sample-kind=&#34;ds&#34;&#xD;&#xA;  data-template-url=&#34;http://localhost:1313/templates/zh-TW/lesson_m01_first_convert.xlsx&#34;&#xD;&#xA;  data-mode=&#34;ds&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;flex flex-wrap items-baseline justify-between gap-2&#34;&gt;&#xD;&#xA;    &lt;p class=&#34;text-sm font-semibold text-slate-800 dark:text-slate-100&#34;&gt;互動課示範&lt;/p&gt;&#xD;&#xA;    &lt;code class=&#34;rounded bg-white px-1.5 py-0.5 font-mono text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300&#34;&gt;lesson_m01_first_convert&lt;/code&gt;&#xD;&#xA;  &lt;/div&gt;&lt;details open class=&#34;jx-demo-previews mt-4 rounded-md border border-slate-200 bg-white/70 p-3 dark:border-slate-700 dark:bg-slate-950/40&#34;&gt;&#xD;&#xA;    &lt;summary class=&#34;cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-200&#34;&gt;預覽圖 &lt;span class=&#34;text-xs font-normal text-slate-500&#34;&gt;(點擊放大)&lt;/span&gt;&lt;/summary&gt;&#xD;&#xA;    &lt;div class=&#34;mt-3 grid gap-4 lg:grid-cols-2&#34;&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/zh-TW/lesson_m01_first_convert/template.png&#34; data-preview-caption=&#34;範本 — lesson_m01_first_convert&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/zh-TW/lesson_m01_first_convert/template.png&#34; alt=&#34;lesson_m01_first_convert template preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;範本&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/zh-TW/lesson_m01_first_convert/result.png&#34; data-preview-caption=&#34;產生結果 — lesson_m01_first_convert&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/zh-TW/lesson_m01_first_convert/result.png&#34; alt=&#34;lesson_m01_first_convert result preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;產生結果&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/details&gt;&lt;div class=&#34;mt-4 grid gap-3 sm:grid-cols-2&#34;&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      語言&#xD;&#xA;      &lt;input&#xD;&#xA;        type=&#34;text&#34;&#xD;&#xA;        class=&#34;jx-demo-lang mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;        value=&#34;zh-TW&#34;&#xD;&#xA;        autocomplete=&#34;off&#34;&#xD;&#xA;      /&gt;&#xD;&#xA;    &lt;/label&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      API 位址&#xD;&#xA;      &lt;input&#xD;&#xA;        type=&#34;text&#34;&#xD;&#xA;        class=&#34;jx-demo-api mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;        value=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;        autocomplete=&#34;off&#34;&#xD;&#xA;      /&gt;&#xD;&#xA;    &lt;/label&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;label class=&#34;mt-4 block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;    範例 JSON（ds）&#xD;&#xA;    &lt;textarea&#xD;&#xA;      class=&#34;jx-demo-json mt-1 h-40 w-full rounded-md border border-slate-300 bg-white p-2 font-mono text-xs leading-relaxed dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;      spellcheck=&#34;false&#34;&#xD;&#xA;    &gt;&lt;/textarea&gt;&#xD;&#xA;  &lt;/label&gt;&#xD;&#xA;&#xD;&#xA;  &lt;div class=&#34;mt-4 flex flex-wrap gap-2&#34;&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; class=&#34;jx-demo-load rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200&#34;&gt;&#xD;&#xA;      載入範例 JSON&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;    &lt;a&#xD;&#xA;      class=&#34;jx-demo-dl-tpl inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200&#34;&#xD;&#xA;      href=&#34;http://localhost:1313/templates/zh-TW/lesson_m01_first_convert.xlsx&#34;&#xD;&#xA;      download&#xD;&#xA;    &gt;下載範本&lt;/a&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; data-format=&#34;excel&#34; class=&#34;jx-demo-convert rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 dark:bg-brand-600 dark:hover:bg-brand-500&#34;&gt;&#xD;&#xA;      產生 Excel&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; data-format=&#34;pdf&#34; class=&#34;jx-demo-convert rounded-md border border-slate-900 px-3 py-1.5 text-sm font-medium text-slate-900 hover:bg-slate-100 dark:border-brand-400 dark:text-brand-200&#34;&gt;&#xD;&#xA;      產生 PDF&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;p class=&#34;jx-demo-status mt-3 min-h-[1.25rem] text-xs text-slate-500 dark:text-slate-400&#34; aria-live=&#34;polite&#34;&gt;&lt;/p&gt;</description>

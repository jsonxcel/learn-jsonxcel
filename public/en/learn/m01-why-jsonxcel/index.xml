				<guid>http://localhost:1313/en/learn/m01-why-jsonxcel/m01-l02-first-convert/</guid>
				<description>&lt;h2 id=&#34;learning-objectives&#34;&gt;Learning objectives&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Assemble a valid &lt;code&gt;POST /api/convert&lt;/code&gt; body for JsonXcel.WebServer&lt;/li&gt;&#xA;&lt;li&gt;Choose &lt;code&gt;language&lt;/code&gt; using BCP-47 folder names (&lt;code&gt;en-US&lt;/code&gt;, &lt;code&gt;zh-CN&lt;/code&gt;, …)&lt;/li&gt;&#xA;&lt;li&gt;Switch between &lt;code&gt;output_format: &amp;quot;excel&amp;quot;&lt;/code&gt; and &lt;code&gt;&amp;quot;pdf&amp;quot;&lt;/code&gt;&lt;/li&gt;&#xA;&lt;li&gt;Interpret stream vs metadata responses via &lt;code&gt;return_file_stream&lt;/code&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;aside&#xD;&#xA;  class=&#34;jx-lesson-demo my-8 rounded-xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/60&#34;&#xD;&#xA;  data-jx-demo&#xD;&#xA;  data-template-name=&#34;lesson_m01_first_convert&#34;&#xD;&#xA;  data-language=&#34;en-US&#34;&#xD;&#xA;  data-api-base=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;  data-site-root=&#34;http://localhost:1313&#34;&#xD;&#xA;  data-sample-url=&#34;http://localhost:1313/samples/en-US/lesson_m01_first_convert.json&#34;&#xD;&#xA;  data-sample-kind=&#34;ds&#34;&#xD;&#xA;  data-template-url=&#34;http://localhost:1313/templates/en-US/lesson_m01_first_convert.xlsx&#34;&#xD;&#xA;  data-mode=&#34;ds&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;flex flex-wrap items-baseline justify-between gap-2&#34;&gt;&#xD;&#xA;    &lt;p class=&#34;text-sm font-semibold text-slate-800 dark:text-slate-100&#34;&gt;Interactive lesson demo&lt;/p&gt;&#xD;&#xA;    &lt;code class=&#34;rounded bg-white px-1.5 py-0.5 font-mono text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300&#34;&gt;lesson_m01_first_convert&lt;/code&gt;&#xD;&#xA;  &lt;/div&gt;&lt;details open class=&#34;jx-demo-previews mt-4 rounded-md border border-slate-200 bg-white/70 p-3 dark:border-slate-700 dark:bg-slate-950/40&#34;&gt;&#xD;&#xA;    &lt;summary class=&#34;cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-200&#34;&gt;Preview images &lt;span class=&#34;text-xs font-normal text-slate-500&#34;&gt;(click to enlarge)&lt;/span&gt;&lt;/summary&gt;&#xD;&#xA;    &lt;div class=&#34;mt-3 grid gap-4 lg:grid-cols-2&#34;&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m01_first_convert/template.png&#34; data-preview-caption=&#34;Template — lesson_m01_first_convert&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m01_first_convert/template.png&#34; alt=&#34;lesson_m01_first_convert template preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Template&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m01_first_convert/result.png&#34; data-preview-caption=&#34;Result — lesson_m01_first_convert&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m01_first_convert/result.png&#34; alt=&#34;lesson_m01_first_convert result preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Result&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/details&gt;&lt;div class=&#34;mt-4 grid gap-3 sm:grid-cols-2&#34;&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      Language&#xD;&#xA;      &lt;in
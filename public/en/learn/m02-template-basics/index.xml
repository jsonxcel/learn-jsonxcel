			<item>
				<title>Mustache field markers</title>
				<link>http://localhost:1313/en/learn/m02-template-basics/m02-l01-mustache/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/en/learn/m02-template-basics/m02-l01-mustache/</guid>
				<description>&lt;h2 id=&#34;learning-objectives&#34;&gt;Learning objectives&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Place &lt;code&gt;{{field}}&lt;/code&gt; markers in workbook cells that map 1:1 to top-level JSON keys&lt;/li&gt;&#xA;&lt;li&gt;Keep Excel formatting on the cell while the engine replaces marker text&lt;/li&gt;&#xA;&lt;li&gt;Convert with &lt;code&gt;template_name: lesson_m02_mustache&lt;/code&gt; and a flat &lt;code&gt;ds&lt;/code&gt; object&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;aside&#xD;&#xA;  class=&#34;jx-lesson-demo my-8 rounded-xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/60&#34;&#xD;&#xA;  data-jx-demo&#xD;&#xA;  data-template-name=&#34;lesson_m02_mustache&#34;&#xD;&#xA;  data-language=&#34;en-US&#34;&#xD;&#xA;  data-api-base=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;  data-site-root=&#34;http://localhost:1313&#34;&#xD;&#xA;  data-sample-url=&#34;http://localhost:1313/samples/en-US/lesson_m02_mustache.json&#34;&#xD;&#xA;  data-sample-kind=&#34;ds&#34;&#xD;&#xA;  data-template-url=&#34;http://localhost:1313/templates/en-US/lesson_m02_mustache.xlsx&#34;&#xD;&#xA;  data-mode=&#34;ds&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;flex flex-wrap items-baseline justify-between gap-2&#34;&gt;&#xD;&#xA;    &lt;p class=&#34;text-sm font-semibold text-slate-800 dark:text-slate-100&#34;&gt;Interactive lesson demo&lt;/p&gt;&#xD;&#xA;    &lt;code class=&#34;rounded bg-white px-1.5 py-0.5 font-mono text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300&#34;&gt;lesson_m02_mustache&lt;/code&gt;&#xD;&#xA;  &lt;/div&gt;&lt;details open class=&#34;jx-demo-previews mt-4 rounded-md border border-slate-200 bg-white/70 p-3 dark:border-slate-700 dark:bg-slate-950/40&#34;&gt;&#xD;&#xA;    &lt;summary class=&#34;cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-200&#34;&gt;Preview images &lt;span class=&#34;text-xs font-normal text-slate-500&#34;&gt;(click to enlarge)&lt;/span&gt;&lt;/summary&gt;&#xD;&#xA;    &lt;div class=&#34;mt-3 grid gap-4 lg:grid-cols-2&#34;&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m02_mustache/template.png&#34; data-preview-caption=&#34;Template — lesson_m02_mustache&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m02_mustache/template.png&#34; alt=&#34;lesson_m02_mustache template preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Template&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m02_mustache/result.png&#34; data-preview-caption=&#34;Result — lesson_m02_mustache&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m02_mustache/result.png&#34; alt=&#34;lesson_m02_mustache result preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Result&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/details&gt;&lt;div class=&#34;mt-4 grid gap-3 sm:grid-cols-2&#34;&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      Language&#xD;&#xA;      &lt;input&#xD;&#xA;        type=&#34;text&#34;&#xD;&#xA;        class=&#34;jx-demo-lang mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;        value=&#34;en-US&#34;&#xD;&#xA;        autocomplete=&#34;off&#34;&#xD;&#xA;      /&gt;&#xD;&#xA;    &lt;/label&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      API base&#xD;&#xA;      &lt;input&#xD;&#xA;        type=&#34;text&#34;&#xD;&#xA;        class=&#34;jx-demo-api mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;        value=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;        autocomplete=&#34;off&#34;&#xD;&#xA;      /&gt;&#xD;&#xA;    &lt;/label&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;label class=&#34;mt-4 block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;    Sample JSON (ds)&#xD;&#xA;    &lt;textarea&#xD;&#xA;      class=&#34;jx-demo-json mt-1 h-40 w-full rounded-md border border-slate-300 bg-white p-2 font-mono text-xs leading-relaxed dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;      spellcheck=&#34;false&#34;&#xD;&#xA;    &gt;&lt;/textarea&gt;&#xD;&#xA;  &lt;/label&gt;&#xD;&#xA;&#xD;&#xA;  &lt;div class=&#34;mt-4 flex flex-wrap gap-2&#34;&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; class=&#34;jx-demo-load rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200&#34;&gt;&#xD;&#xA;      Load sample JSON&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;    &lt;a&#xD;&#xA;      class=&#34;jx-demo-dl-tpl inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200&#34;&#xD;&#xA;      href=&#34;http://localhost:1313/templates/en-US/lesson_m02_mustache.xlsx&#34;&#xD;&#xA;      download&#xD;&#xA;    &gt;Download template&lt;/a&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; data-format=&#34;excel&#34; class=&#34;jx-demo-convert rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 dark:bg-brand-600 dark:hover:bg-brand-500&#34;&gt;&#xD;&#xA;      Generate Excel&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; data-format=&#34;pdf&#34; class=&#34;jx-demo-convert rounded-md border border-slate-900 px-3 py-1.5 text-sm font-medium text-slate-900 hover:bg-slate-100 dark:border-brand-400 dark:text-brand-200&#34;&gt;&#xD;&#xA;      Generate PDF&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;p class=&#34;jx-demo-status mt-3 min-h-[1.25rem] text-xs text-slate-500 dark:text-slate-400&#34; aria-live=&#34;polite&#34;&gt;&lt;/p&gt;</description>
			</item>
			<item>
				<title>Nested objects and array expansion</title>
				<link>http://localhost:1313/en/learn/m02-template-basics/m02-l02-nested-path/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/en/learn/m02-template-basics/m02-l02-nested-path/</guid>
				<description>&lt;h2 id=&#34;learning-objectives&#34;&gt;Learning objectives&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Bind nested properties with dotted paths such as &lt;code&gt;{{ds.buyer.address.city}}&lt;/code&gt;&lt;/li&gt;&#xA;&lt;li&gt;Expand array rows with collection fields such as &lt;code&gt;{{ds.items.sku}}&lt;/code&gt;&lt;/li&gt;&#xA;&lt;li&gt;Know that numeric indexes like &lt;code&gt;items.0.sku&lt;/code&gt; are &lt;strong&gt;not&lt;/strong&gt; the engine path — use expansion (Module 04) for layout control&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;aside&#xD;&#xA;  class=&#34;jx-lesson-demo my-8 rounded-xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/60&#34;&#xD;&#xA;  data-jx-demo&#xD;&#xA;  data-template-name=&#34;lesson_m02_nested_path&#34;&#xD;&#xA;  data-language=&#34;en-US&#34;&#xD;&#xA;  data-api-base=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;  data-site-root=&#34;http://localhost:1313&#34;&#xD;&#xA;  data-sample-url=&#34;http://localhost:1313/samples/en-US/lesson_m02_nested_path.json&#34;&#xD;&#xA;  data-sample-kind=&#34;ds&#34;&#xD;&#xA;  data-template-url=&#34;http://localhost:1313/templates/en-US/lesson_m02_nested_path.xlsx&#34;&#xD;&#xA;  data-mode=&#34;ds&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;flex flex-wrap items-baseline justify-between gap-2&#34;&gt;&#xD;&#xA;    &lt;p class=&#34;text-sm font-semibold text-slate-800 dark:text-slate-100&#34;&gt;Interactive lesson demo&lt;/p&gt;&#xD;&#xA;    &lt;code class=&#34;rounded bg-white px-1.5 py-0.5 font-mono text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300&#34;&gt;lesson_m02_nested_path&lt;/code&gt;&#xD;&#xA;  &lt;/div&gt;&lt;details open class=&#34;jx-demo-previews mt-4 rounded-md border border-slate-200 bg-white/70 p-3 dark:border-slate-700 dark:bg-slate-950/40&#34;&gt;&#xD;&#xA;    &lt;summary class=&#34;cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-200&#34;&gt;Preview images &lt;span class=&#34;text-xs font-normal text-slate-500&#34;&gt;(click to enlarge)&lt;/span&gt;&lt;/summary&gt;&#xD;&#xA;    &lt;div class=&#34;mt-3 grid gap-4 lg:grid-cols-2&#34;&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m02_nested_path/template.png&#34; data-preview-caption=&#34;Template — lesson_m02_nested_path&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m02_nested_path/template.png&#34; alt=&#34;lesson_m02_nested_path template preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Template&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m02_nested_path/result.png&#34; data-preview-caption=&#34;Result — lesson_m02_nested_path&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m02_nested_path/result.png&#34; alt=&#34;lesson_m02_nested_path result preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Result&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/details&gt;&lt;div class=&#34;mt-4 grid gap-3 sm:grid-cols-2&#34;&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      Language&#xD;&#xA;      &lt;input&#xD;&#xA;        type=&#34;text&#34;&#xD;&#xA;        class=&#34;jx-demo-lang mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;        value=&#34;en-US&#34;&#xD;&#xA;        autocomplete=&#34;off&#34;&#xD;&#xA;      /&gt;&#xD;&#xA;    &lt;/label&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      API base&#xD;&#xA;      &lt;input&#xD;&#xA;        type=&#34;text&#34;&#xD;&#xA;        class=&#34;jx-demo-api mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;        value=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;        autocomplete=&#34;off&#34;&#xD;&#xA;      /&gt;&#xD;&#xA;    &lt;/label&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;label class=&#34;mt-4 block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;    Sample JSON (ds)&#xD;&#xA;    &lt;textarea&#xD;&#xA;      class=&#34;jx-demo-json mt-1 h-40 w-full rounded-md border border-slate-300 bg-white p-2 font-mono text-xs leading-relaxed dark:border-slate-600 dark:bg-slate-950&#34;&#xD;&#xA;      spellcheck=&#34;false&#34;&#xD;&#xA;    &gt;&lt;/textarea&gt;&#xD;&#xA;  &lt;/label&gt;&#xD;&#xA;&#xD;&#xA;  &lt;div class=&#34;mt-4 flex flex-wrap gap-2&#34;&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; class=&#34;jx-demo-load rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200&#34;&gt;&#xD;&#xA;      Load sample JSON&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;    &lt;a&#xD;&#xA;      class=&#34;jx-demo-dl-tpl inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200&#34;&#xD;&#xA;      href=&#34;http://localhost:1313/templates/en-US/lesson_m02_nested_path.xlsx&#34;&#xD;&#xA;      download&#xD;&#xA;    &gt;Download template&lt;/a&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; data-format=&#34;excel&#34; class=&#34;jx-demo-convert rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 dark:bg-brand-600 dark:hover:bg-brand-500&#34;&gt;&#xD;&#xA;      Generate Excel&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;    &lt;button type=&#34;button&#34; data-format=&#34;pdf&#34; class=&#34;jx-demo-convert rounded-md border border-slate-900 px-3 py-1.5 text-sm font-medium text-slate-900 hover:bg-slate-100 dark:border-brand-400 dark:text-brand-200&#34;&gt;&#xD;&#xA;      Generate PDF&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;  &lt;p class=&#34;jx-demo-status mt-3 min-h-[1.25rem] text-xs text-slate-500 dark:text-slate-400&#34; aria-live=&#34;polite&#34;&gt;&lt;/p&gt;</description>
			</item>
			<item>
				<title>Expressions and formula cells</title>
				<link>http://localhost:1313/en/learn/m02-template-basics/m02-l03-expression/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/en/learn/m02-template-basics/m02-l03-expression/</guid>
				<description>&lt;h2 id=&#34;learning-objectives&#34;&gt;Learning objectives&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Bind input cells with mustache markers while leaving &lt;strong&gt;Excel formulas&lt;/strong&gt; for derived values&lt;/li&gt;&#xA;&lt;li&gt;Prefer engine-side expressions only when the template engine documents them; otherwise keep math in native Excel formulas&lt;/li&gt;&#xA;&lt;li&gt;Convert once and open the workbook to see formulas still live&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;aside&#xD;&#xA;  class=&#34;jx-lesson-demo my-8 rounded-xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/60&#34;&#xD;&#xA;  data-jx-demo&#xD;&#xA;  data-template-name=&#34;lesson_m02_expression&#34;&#xD;&#xA;  data-language=&#34;en-US&#34;&#xD;&#xA;  data-api-base=&#34;https://api.jsonxcel.com:2053&#34;&#xD;&#xA;  data-site-root=&#34;http://localhost:1313&#34;&#xD;&#xA;  data-sample-url=&#34;http://localhost:1313/samples/en-US/lesson_m02_expression.json&#34;&#xD;&#xA;  data-sample-kind=&#34;ds&#34;&#xD;&#xA;  data-template-url=&#34;http://localhost:1313/templates/en-US/lesson_m02_expression.xlsx&#34;&#xD;&#xA;  data-mode=&#34;ds&#34;&#xD;&#xA;&gt;&#xD;&#xA;  &lt;div class=&#34;flex flex-wrap items-baseline justify-between gap-2&#34;&gt;&#xD;&#xA;    &lt;p class=&#34;text-sm font-semibold text-slate-800 dark:text-slate-100&#34;&gt;Interactive lesson demo&lt;/p&gt;&#xD;&#xA;    &lt;code class=&#34;rounded bg-white px-1.5 py-0.5 font-mono text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300&#34;&gt;lesson_m02_expression&lt;/code&gt;&#xD;&#xA;  &lt;/div&gt;&lt;details open class=&#34;jx-demo-previews mt-4 rounded-md border border-slate-200 bg-white/70 p-3 dark:border-slate-700 dark:bg-slate-950/40&#34;&gt;&#xD;&#xA;    &lt;summary class=&#34;cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-200&#34;&gt;Preview images &lt;span class=&#34;text-xs font-normal text-slate-500&#34;&gt;(click to enlarge)&lt;/span&gt;&lt;/summary&gt;&#xD;&#xA;    &lt;div class=&#34;mt-3 grid gap-4 lg:grid-cols-2&#34;&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m02_expression/template.png&#34; data-preview-caption=&#34;Template — lesson_m02_expression&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m02_expression/template.png&#34; alt=&#34;lesson_m02_expression template preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Template&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;figure class=&#34;jx-demo-preview-fig&#34;&gt;&#xD;&#xA;        &lt;button type=&#34;button&#34; class=&#34;jx-demo-preview-zoom group block w-full text-left&#34; data-preview-src=&#34;http://localhost:1313/previews/en-US/lesson_m02_expression/result.png&#34; data-preview-caption=&#34;Result — lesson_m02_expression&#34;&gt;&#xD;&#xA;          &lt;img src=&#34;http://localhost:1313/previews/en-US/lesson_m02_expression/result.png&#34; alt=&#34;lesson_m02_expression result preview&#34; class=&#34;jx-demo-preview-img&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;        &lt;figcaption class=&#34;mt-1.5 text-xs text-slate-500&#34;&gt;Result&lt;/figcaption&gt;&#xD;&#xA;      &lt;/figure&gt;&lt;/div&gt;&#xD;&#xA;  &lt;/details&gt;&lt;div class=&#34;mt-4 grid gap-3 sm:grid-cols-2&#34;&gt;&#xD;&#xA;    &lt;label class=&#34;block text-xs font-medium text-slate-600 dark:text-slate-400&#34;&gt;&#xD;&#xA;      Language&#xD;&#xA;      &lt;input&#xD;&#xA;        type=&#34;text&#34;&#xD;&#xA;        class=&#34;jx-demo-lang mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm dark:border-slate-600 dark:bg-slate-9
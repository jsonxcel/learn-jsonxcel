 data-site-root="https://jsonxcel.github.io/learn-jsonxcel"
 data-sample-url="https://jsonxcel.github.io/learn-jsonxcel/samples/zh-TW/lesson_m02_inline.json"
 data-sample-kind="ds"
 data-template-url="https://jsonxcel.github.io/learn-jsonxcel/templates/zh-TW/lesson_m02_inline.xlsx"
